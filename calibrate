#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/config"
cd "$root"
mkdir -p runs/moshi-calibration runs/personaplex-calibration

CUDA_VISIBLE_DEVICES=$moshi_gpu "$moshi_python" calibrate.py moshi \
    >runs/moshi-calibration/run.log 2>&1 &
moshi_pid=$!
CUDA_VISIBLE_DEVICES=$personaplex_gpu "$personaplex_python" calibrate.py personaplex \
    >runs/personaplex-calibration/run.log 2>&1 &
personaplex_pid=$!
wait "$moshi_pid"
wait "$personaplex_pid"
